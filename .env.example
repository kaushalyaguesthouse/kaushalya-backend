# ===========================
# Environment
# ===========================
NODE_ENV=production
PORT=10000

# ===========================
# Supabase
# ===========================
SUPABASE_URL=https://your-actual-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_actual_service_role_key

# ===========================
# Razorpay
# ===========================
RAZORPAY_KEY_ID=your_actual_razorpay_key_id
RAZORPAY_KEY_SECRET=your_actual_razorpay_key_secret

# ===========================
# Admin Security
# ===========================
# Generate with: openssl rand -base64 48
ADMIN_SESSION_SECRET=your_long_random_signing_secret_of_at_least_32_characters
ADMIN_BOOTSTRAP_KEY=your_another_long_random_secret

# ===========================
# Allowed Frontend Origins
# ===========================
ALLOWED_ORIGINS=https://kaushalyaguesthouse.github.io
REQUEST_BODY_LIMIT=100kb
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000

# ===========================
# Room Configuration
# ===========================
ROOM_TYPES=Standard,Deluxe

ROOM_PRICE_STANDARD=1800
ROOM_INVENTORY_STANDARD=1

ROOM_PRICE_DELUXE=2500
ROOM_INVENTORY_DELUXE=1

# ===========================
# Booking Rules
# ===========================
MAX_STAY_NIGHTS=90
MAX_GUESTS_PER_BOOKING=10

PAYMENT_METHODS=Pay Later,Razorpay

# ===========================
# Email
# ===========================
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_TOKEN=

